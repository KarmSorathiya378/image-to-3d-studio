# Dependencies
node_modules/
.pnp
.pnp.js

# Production and build outputs
.next/
out/
dist/
build/
coverage/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Environment and secrets (keep .env.example)
.env
.env.*
!.env.example

# Local data, uploads, temporary files
data/
uploads/
tmp/
temp/
*.tmp

# 3D assets (ignore binaries except test fixtures)
*.glb
*.gltf
*.blend
*.blend1
!**/fixtures/**/*.glb
!**/fixtures/**/*.gltf
!**/fixtures/**/*.blend
!tests/fixtures/**/*.glb
!tests/fixtures/**/*.gltf
!tests/fixtures/**/*.blend

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Marshell harness internal files
.marshell/
