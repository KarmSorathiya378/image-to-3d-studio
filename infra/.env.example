# ==============================================================================
# AI Image-to-3D Studio - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR PRODUCTION API KEYS TO VERSION CONTROL.
# Copy this template to .env or pass with --env-file when starting containers.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
NODE_ENV=production

# ------------------------------------------------------------------------------
# Port Mappings
# ------------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000
BLENDER_WORKER_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Service URLs
# ------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
GEOMETRY_WORKER_URL=http://blender-worker:8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# In docker-compose, hostname 'postgres' points to the db container
# ------------------------------------------------------------------------------
POSTGRES_DB=image_to_3d
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/image_to_3d
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@postgres:5432/image_to_3d

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration
# In docker-compose, hostname 'redis' points to the redis container
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO local default)
# In docker-compose, hostname 'minio' points to the storage container
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=private-model-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# Security & Cryptography Keys
# MUST BE REPLACED WITH CRYPTOGRAPHICALLY SECURE VALUES IN PRODUCTION
# e.g., generated with: openssl rand -base64 32
# ------------------------------------------------------------------------------
# Session / JWT signing secret (min 32 bytes)
AUTH_SECRET=dev-insecure-secret-key-change-in-prod-32bytes!
JWT_SECRET=dev-insecure-secret-key-change-in-prod-32bytes!

# Master key for user BYOK credential envelope encryption at rest (32 bytes)
CREDENTIAL_ENCRYPTION_MASTER_KEY=dev-master-encryption-key-for-credentials-32b
ENCRYPTION_KEY=dev-master-encryption-key-for-credentials-32b

# ------------------------------------------------------------------------------
# Engine & Worker Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_CONCURRENT_GENERATIONS_PER_USER=1
MAX_SCENE_PARTS=64
MAX_SCENE_TRIANGLES=250000
WORKER_POLL_INTERVAL_SECONDS=3.0
